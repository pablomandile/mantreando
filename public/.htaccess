<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

# El manifest se servía como text/plain (Hostinger no conoce la extensión).
# Chrome lo tolera, pero la spec pide application/manifest+json y Firefox es
# estricto: sin esto la PWA no se ofrece para instalar en Firefox.
<IfModule mod_mime.c>
    AddType application/manifest+json .webmanifest
</IfModule>

# El navegador se entera de que hay un service worker nuevo pegándole a /sw.js,
# y de un manifest nuevo pegándole a /manifest.webmanifest. Hostinger los servía
# con `public, max-age=604800` (sw.js) y sin Cache-Control (el manifest), así que
# el CDN entregaba los viejos durante días: ninguna actualización llegaba, y como
# el SW controla las demás caches, eso congelaba todo lo demás también.
<IfModule mod_headers.c>
    <FilesMatch "^(sw\.js|manifest\.webmanifest)$">
        Header set Cache-Control "no-cache, must-revalidate, max-age=0"
        # mod_expires seguia mandando un Expires a 7 dias. Ante max-age=0 la
        # spec obliga a ignorarlo, pero justamente el problema de este CDN es
        # que hace lo que quiere con las cabeceras: mejor no dejarlo escrito.
        Header unset Expires
    </FilesMatch>
</IfModule>
